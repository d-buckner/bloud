# Core platform services must already be provisioned on the target host.
DATABASE_URL=postgres://apps:replace-me@localhost:5432/bloud_e2e?sslmode=disable
BLOUD_REDIS_ADDR=localhost:6379
BLOUD_AUTHENTIK_PORT=9000
BLOUD_AUTHENTIK_TOKEN=replace-me
BLOUD_AUTHENTIK_ADMIN_PASSWORD=replace-me
BLOUD_LDAP_HOST=apps-authentik-ldap
BLOUD_LDAP_BIND_PASSWORD=replace-me
BLOUD_SSO_BASE_URL=http://replace-with-runtime-ingress
BLOUD_SSO_AUTHENTIK_URL=http://replace-with-runtime-ingress
# Set BLOUD_E2E_TRAEFIK_DYNAMIC_DIR when invoking the runner to the directory
# watched by the target ingress.
