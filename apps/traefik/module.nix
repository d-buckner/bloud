{ config, pkgs, lib, ... }:

let
  mkNativeApp = import ../../nixos/lib/native-app.nix { inherit config pkgs lib; };
in
mkNativeApp {
  name = "traefik";
  description = "Traefik reverse proxy";
  port = 80;
  serviceName = "traefik";
  # Traefik has no configurator — no runtime secrets or config injection needed
  configuratorHooks = false;
  options = {
    apiPort = {
      type = lib.types.int;
      default = 3000;
      description = "Port for the host-agent API backend";
    };
    uiPort = {
      type = lib.types.int;
      default = 5173;
      description = "Port for the Bloud UI (Vite dev server)";
    };
  };

  nixosConfig = cfg: {
    services.traefik = {
      enable = true;
      staticConfigOptions = {
        entryPoints.web.address = ":${toString cfg.port}";
        providers.file = {
          # Watch the directory where host-agent writes dynamic config.
          # BindReadOnlyPaths below exposes this path through ProtectHome sandbox.
          directory = "${cfg.secretsDir}/traefik/dynamic/";
          watch = true;
        };
        api.dashboard = true;
        ping.entryPoint = "web";
        log.level = "DEBUG";
      };
    };

    # ProtectHome=true in traefik.service blocks all access to /home directories.
    # Override to read-only so traefik can read the dynamic config directory.
    # Filesystem permissions (711 home, 755 dirs, 644 files) still limit what
    # the traefik user can actually access within /home.
    systemd.services.traefik.serviceConfig.ProtectHome = lib.mkForce "read-only";

    # Write static dynamic config files atomically on every NixOS activation.
    # IMPORTANT: Use atomic writes (write to .tmp, then mv) to prevent Traefik
    # from seeing truncated files during config reload.
    # base.yml: static routes — UI, API, dashboard, common middlewares.
    # apps-routes.yml: managed by host-agent traefikgen at runtime; only create
    # placeholder on first activation, never overwrite an existing file.
    system.activationScripts.bloud-traefik-config = lib.stringAfter [ "users" ] ''
      mkdir -p ${cfg.secretsDir}/traefik/dynamic

      cat > ${cfg.secretsDir}/traefik/dynamic/base.yml.tmp <<'EOF'
http:
  routers:
    # Traefik dashboard (access via /dashboard/)
    traefik-dashboard:
      rule: "PathPrefix(`/dashboard`)"
      service: api@internal
      priority: 95

    # Host agent API
    host-api:
      rule: "PathPrefix(`/api`)"
      service: host-agent
      priority: 90

    # Host agent auth routes (OAuth login/callback/logout)
    host-auth:
      rule: "PathPrefix(`/auth`)"
      service: host-agent
      priority: 89

    # Authentik outpost endpoints (for OAuth start/callback flows)
    # Traefik adds X-Forwarded-* headers which the outpost needs to match providers
    authentik-outpost:
      rule: "PathPrefix(`/outpost.goauthentik.io`)"
      service: authentik-outpost
      priority: 85

    # Bloud UI (catch-all, handles /{appname} routes internally)
    bloud-ui:
      rule: "PathPrefix(`/`)"
      middlewares:
        - cross-origin-isolation
      service: bloud-ui
      priority: 1

  middlewares:
    # Cross-origin isolation headers for SharedArrayBuffer support
    # 'credentialless' enables SharedArrayBuffer while being more permissive than 'require-corp'
    cross-origin-isolation:
      headers:
        customResponseHeaders:
          Cross-Origin-Opener-Policy: "same-origin"
          Cross-Origin-Embedder-Policy: "credentialless"

    # Common middleware for iframe embedding - removes restrictive headers from apps
    iframe-headers:
      headers:
        customResponseHeaders:
          X-Frame-Options: ""
          Content-Security-Policy: ""

    # Embed isolation headers - matches parent page COOP/COEP
    embed-isolation:
      headers:
        customResponseHeaders:
          Cross-Origin-Opener-Policy: "same-origin"
          Cross-Origin-Embedder-Policy: "credentialless"

    # Forward headers for embedded apps - ensures apps know their public URL
    # This is critical for apps like Jellyfin that need to return correct
    # LocalAddress in API responses to avoid "server mismatch" warnings
    embed-forwarded-headers:
      headers:
        customRequestHeaders:
          X-Forwarded-Host: "localhost:${toString cfg.port}"
          X-Forwarded-Proto: "http"

  services:
    host-agent:
      loadBalancer:
        servers:
          - url: "http://localhost:${toString cfg.apiPort}"

    bloud-ui:
      loadBalancer:
        servers:
          - url: "http://localhost:${toString cfg.uiPort}"

    # Authentik server (serves outpost endpoints via embedded outpost)
    authentik-outpost:
      loadBalancer:
        servers:
          - url: "http://localhost:9001"
EOF
      mv ${cfg.secretsDir}/traefik/dynamic/base.yml.tmp ${cfg.secretsDir}/traefik/dynamic/base.yml

      # App routes (generated by host-agent traefikgen)
      # Create empty placeholder if not exists (atomic write)
      if [ ! -f ${cfg.secretsDir}/traefik/dynamic/apps-routes.yml ]; then
        cat > ${cfg.secretsDir}/traefik/dynamic/apps-routes.yml.tmp <<'EOF'
# Generated by Bloud - DO NOT EDIT MANUALLY
# This file is managed by the Bloud host agent
# Traefik watches this file for changes

# No routable apps installed yet
EOF
        mv ${cfg.secretsDir}/traefik/dynamic/apps-routes.yml.tmp ${cfg.secretsDir}/traefik/dynamic/apps-routes.yml
      fi

      chown -R ${cfg.bloudUser}:users ${cfg.secretsDir}/traefik
    '';
  };
}
