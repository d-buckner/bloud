{
  "name": "bloud",
  "private": false,
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "workspaces": [
    "services/host-agent",
    "services/host-agent/web"
  ],
  "scripts": {
    "setup": "npm install && npm run cli:build && ./bloud setup",
    "prepare": "husky",
    "cli:build": "cd cli && go build -o ../bloud .",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "frontend:dev": "npm run dev --workspace=services/host-agent/web",
    "backend:dev": "cd services/host-agent && go run ./cmd/host-agent",
    "backend:build": "cd services/host-agent && go build -o bin/host-agent ./cmd/host-agent",
    "lint:go": "npm run lint:go:host-agent && npm run lint:go:apps && npm run lint:go:cli",
    "lint": "npm run lint:go && npm run check:gofmt && npm run lint:web && npm run lint:prose && npm run check:no-emdash && npm run check:docs-links && npm run check:image-pins && npm run check:file-length",
    "lint:go:host-agent": "cd services/host-agent && go run github.com/golangci/golangci-lint/v2/cmd/golangci-lint@v2.13.2 run ./...",
    "lint:go:apps": "cd apps && go run github.com/golangci/golangci-lint/v2/cmd/golangci-lint@v2.13.2 run ./...",
    "lint:go:cli": "cd cli && go run github.com/golangci/golangci-lint/v2/cmd/golangci-lint@v2.13.2 run ./...",
    "lint:web": "npm run lint --workspace=@bloud/host-agent-web",
    "lint:prose": "node scripts/prose-lint.mjs",
    "lint:prose:sync": "go run github.com/vale-cli/vale/v3/cmd/vale@v3.22.0 sync --plain-progress",
    "check:no-emdash": "node scripts/no-emdash.mjs",
    "check:docs-links": "node scripts/docs-links.mjs",
    "check:image-pins": "node scripts/pinned-images.mjs",
    "check:gofmt": "node scripts/gofmt-check.mjs",
    "check:file-length": "node scripts/file-length.mjs",
    "check:file-length:update": "node scripts/file-length.mjs --update",
    "test": "npm run test:unit",
    "test:go": "cd services/host-agent && go run gotest.tools/gotestsum --format testdox ./...",
    "test:go:apps": "cd apps && go run gotest.tools/gotestsum --format testdox ./...",
    "test:go:all": "npm run test:go && npm run test:go:apps",
    "test:ts": "npm run test --workspace=@bloud/host-agent-web",
    "test:go:coverage": "cd services/host-agent && go test -coverprofile=coverage.out ./... && go tool cover -func=coverage.out | tail -1",
    "license:check": "node scripts/license-header.mjs check",
    "license:fix": "node scripts/license-header.mjs fix",
    "test:unit": "npm run test:go:all && npm run test:ts",
    "test:precommit": "node scripts/checks.mjs all",
    "checks:commit": "node scripts/checks.mjs commit",
    "checks:push": "node scripts/checks.mjs push",
    "test:e2e": "npm --prefix e2e test",
    "show-report": "cd e2e && npx playwright show-report"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "turbo": "^2.0.0"
  },
  "packageManager": "npm@10.0.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
